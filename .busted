return {
  _all = {
    coverage = false,
    -- On Windows, Neovim may attach its built-in LSP file watcher to Busted's
    -- temporary Lua runner before the test helper loads. The runner is then
    -- deleted, causing the watcher callback to repeatedly fail with EPERM.
    -- Disable only that test-harness watcher before Busted executes its script.
    lua = "nvim --clean -U NONE -N -i NONE --cmd \"lua pcall(function() vim.lsp._watchfiles._watchfunc = function() return function() end end end)\" -l",
  },
  default = {
    helper = "./spec/minimal_init.lua",
    verbose = true,
  },
  tests = {
    verbose = true,
  },
}
